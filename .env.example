# Google OAuth — 在 Google Cloud Console 创建 OAuth 2.0 客户端后填写
# 授权回调 URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# better-auth — 至少 32 字符，用 `openssl rand -base64 32` 生成
BETTER_AUTH_SECRET=

# 部署到正式环境的公开地址
BETTER_AUTH_URL=http://localhost:3000

# 可选：覆盖默认的 sqlite.db 路径
# FREETEXTTOIMAGE_DB_PATH=

# Postmark Magic Link 邮件。发件地址必须已在 Postmark 验证。
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL="FreeTexttoImage <hello@example.com>"
# 可选，默认使用 Postmark 的 outbound transactional stream
# POSTMARK_MESSAGE_STREAM=outbound

# ── KIE 图像生成（https://docs.kie.ai）─────────────
# 到 KIE 控制台申请 API key 后填写
KIE_API_KEY=
# 对外可达的公网地址，用于 KIE 回调（/api/webhooks/kie）。
# 生产环境必填（回调=快通道）；本地开发留空 → 自动走轮询兜底
APP_URL=

# ── 作品图片存储（s3mini 轻量客户端，兼容任何 S3 服务）──────
# 二选一：
#  A. AWS S3（云端）：填 BUCKET + REGION，SDK 自动拼 https://{bucket}.s3.{region}.amazonaws.com
S3_BUCKET=
S3_REGION=us-east-1
#  B. 自建 S3 兼容（MinIO 等）：填完整 endpoint，且必须带上桶名，如 http://localhost:9000/mybucket
#     （路径式）或 https://my-bucket.s3.xxx.amazonaws.com（虚拟主机式）。填了 ENDPOINT 则优先于 A
# S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 可选：公开桶的下载基址。配置后图片由浏览器直连对象存储，不经过应用鉴权代理。
# 注意：拿到图片 URL 的人无需登录即可访问。
# S3_PUBLIC_URL=https://f005.backblazeb2.com/file/freetexttoimage
